// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String   @default("Member")
  email     String   @unique
  no_wa     String?  @unique
  password  String
  role      String   @default("MEMBER") // "ADMIN" atau "MEMBER"
  orders    Order[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Tema {
  id           Int      @id @default(autoincrement())
  nama_tema    String
  kategori     String   @default("Pernikahan")
  gambar       String
  link_demo    String
  harga_asli   Float    @default(0)
  harga_diskon Float?
  orders       Order[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Promo {
  id         Int      @id @default(autoincrement())
  gambar     String
  keterangan String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}



model Setting {
  id          Int      @id @default(autoincrement())
  nomor_wa    String   @default("628123456789")
  email       String?
  instagram   String?
  facebook    String?
  tiktok      String?
  twitter     String?
  youtube     String?
  waTemplate  String?  @db.Text
  promoBanner String?
  showPromo   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Order {
  id             Int      @id @default(autoincrement())
  nama_pelanggan String
  no_wa          String?
  temaId         Int
  tema           Tema     @relation(fields: [temaId], references: [id])
  harga          Float
  status         String   @default("Pending") // Pending, Diproses, Selesai
  userId         String?
  user           User?    @relation(fields: [userId], references: [id])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model PageVisit {
  id        Int      @id @default(autoincrement())
  date      String   @unique // Format: YYYY-MM-DD
  count     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PushSubscription {
  id        Int      @id @default(autoincrement())
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AdminInvitation {
  id        String   @id @default(cuid())
  email     String   @unique
  token     String   @unique
  createdAt DateTime @default(now())
  expiresAt DateTime
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  createdAt DateTime @default(now())
  expiresAt DateTime
}

model PasswordChangeRequest {
  id              String   @id @default(cuid())
  userId          String   @unique
  hashedPassword  String
  token           String   @unique
  createdAt       DateTime @default(now())
  expiresAt       DateTime
}
